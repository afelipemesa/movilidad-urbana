# CSV sueltos en la raiz del repo (p. ej. una descarga propia de Scopus
# para replicar con datos mas recientes): no se versionan. El corpus
# del articulo SI se versiona, pero vive en data/corpus/, no en la raiz.
/*.csv

# Embeddings cacheados (~400 MB): se regeneran en la primera corrida.
cache/

# Salida completa del paso 1 (30-45 MB): se regenera con
# reproducir_resultados.py a partir de data/corpus/.
*.xlsx

# Resultados: ya no se publican precalculados. Se regeneran corriendo
# el pipeline completo desde data/corpus/ (ver README).
outputs/
data/derived/

# Entorno y temporales
venv/
.venv/
__pycache__/
*.pyc
~$*
*.bat
